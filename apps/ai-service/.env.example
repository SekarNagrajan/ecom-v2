# Modified by Sekar Nagarajan (2026-10-21 02:40)
# Copy to .env for local development. Never commit real keys or .env.

# ── runtime ──────────────────────────────────────────────────────────────
ENV=development                 # local | development | staging | production
AUTH_MODE=trusted-dev           # trusted-dev | backend-introspect
BACKEND_BASE_URL=http://localhost:8080

# Real Redis (docker compose up redis):
# REDIS_URL=redis://localhost:6379/0
# Zero-infra dev store (in-process, non-persistent, rejected in production):
REDIS_URL=memory://

# ── model provider ───────────────────────────────────────────────────────
# Local default: Ollama via OpenAI-compatible API (no cloud key).
# For Anthropic, set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY.
LLM_PROVIDER=openai             # anthropic | openai
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_CHAT_MODEL=llama3.2:3b
OPENAI_GUARD_MODEL=llama3.2:3b
# Stronger tool calling (needs more RAM): OPENAI_CHAT_MODEL=qwen2.5:7b

# Anthropic (production target) — unused when LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
LLM_CHAT_MODEL=claude-sonnet-5-5
LLM_GUARD_MODEL=claude-haiku-5-5
LLM_CHAT_EFFORT=low
LLM_MAX_TOKENS=8000
LLM_ENABLE_FALLBACK=true
LLM_ENABLE_COMPACTION=true

# Or cloud OpenAI / Groq / OpenRouter — leave OPENAI_BASE_URL empty for api.openai.com.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_GUARD_MODEL=gpt-4o-mini

# ── data + actions ───────────────────────────────────────────────────────
DATA_SOURCE=mock                # mock (portal fixtures) | api (Spring Boot)
FIXTURES_PATH=../ecom-portal/src/mocks/fixtures
SERVER_ACTIONS_ENABLED=false    # true runs catalog tools in the service

# ── retrieval ────────────────────────────────────────────────────────────
RAG_VECTOR_ENABLED=true
VECTOR_DB_PATH=var/vector-db
# Label only. Changing it forces a full index rebuild, because vectors from
# two embedding models are not comparable.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── SQL analysis mode (optional) ─────────────────────────────────────────
# SQL_SERVICE_URL=
# SQL_SERVICE_TOKEN=
SQL_QUERY_TIMEOUT_SECONDS=30

# ── limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_PER_DAY=200
MAX_MESSAGE_CHARS=4000
MAX_TOOL_ROUNDS=5
TOOL_RESULT_MAX_BYTES=8000
CONVERSATION_TTL_SECONDS=86400
MAX_USER_TURNS_PER_CONVERSATION=40

# ── trusted-dev identity (ignored under backend-introspect) ──────────────
DEV_USER_ID=dev-user
DEV_TENANT_CODE=DEMO
DEV_CAPABILITIES=BKG,SI,BL,VGM,CRO,DO,ARN,PAY,SQL
