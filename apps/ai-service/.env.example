# Modified by Sekar Nagarajan (2026-10-20 20:50)
# Copy to .env for local development. Never commit real keys.

ENV=development
AUTH_MODE=trusted-dev
REDIS_URL=redis://localhost:6379/0

# --- LLM provider ---
# Local default: Ollama via OpenAI-compatible API (no cloud key).
# For production Anthropic, set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY.
LLM_PROVIDER=openai
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_CHAT_MODEL=llama3.2:3b
OPENAI_GUARD_MODEL=llama3.2:3b
# Stronger tool calling (needs more RAM): OPENAI_CHAT_MODEL=qwen2.5:7b

# Anthropic (production target) — unused when LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
LLM_CHAT_MODEL=claude-sonnet-5-5
LLM_GUARD_MODEL=claude-haiku-5-5
LLM_ROUTER_MODEL=claude-haiku-5-5
LLM_CHAT_EFFORT=low
LLM_EFFORT=low
LLM_ENABLE_FALLBACK=true
LLM_ENABLE_COMPACTION=true

BACKEND_BASE_URL=http://localhost:8080
# Optional: controlled SQL service base URL (POST {url}/run-sql). Leave empty to disable execution.
SQL_SERVICE_URL=
SQL_SERVICE_TOKEN=
SQL_QUERY_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MIN=30
DAILY_MSG_CAP=200
RATE_LIMIT_PER_DAY=200
MAX_MESSAGE_LENGTH=4000
MAX_TOOL_ROUNDS=5
TOOL_RESULT_MAX_BYTES=8000
MAX_USER_TURNS_PER_CONVERSATION=40

# Trusted-dev only: default user when Authorization is absent
DEV_USER_ID=dev-user
DEV_TENANT_CODE=DEMO
DEV_CAPABILITIES=BKG,SI,BL,VGM,CRO,DO,ARN,PAY,SQL
