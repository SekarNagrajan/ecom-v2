# Copy to .env.local for local overrides (not committed).

# Portal API mode: mock (MSW + fixtures) | real (Spring Boot)
# VITE_API_MODE=mock

# Backend host only for real mode. Paths already carry /api/v1, so do NOT append it here.
# VITE_API_URL=http://localhost:8080

# AG Grid Enterprise licence key (blank = trial watermark)
# VITE_AG_GRID_LICENSE_KEY=

# Live AIS vessel positions WebSocket proxy (tracking map)
# VITE_AIS_PROXY_URL=ws://localhost:8787

# Conversational assistant launcher (roadmap F11): "true" | "false"
# VITE_ASSISTANT_ENABLED=false
# VITE_AI_ASSISTANT_USE_MSW_STUB=false

# AI text assist (/api/ai/grammar|transcribe|rewrite)
#   dev:  Vite Node proxy (vite-ai-n8n-proxy.ts)
#   prod: Vercel edge function api/ai/[route].ts (same-origin gateway, rate-limited)
# Node / Vercel env (not VITE_*):
# N8N_BASE_URL=https://n8n.sedge.ai/webhook
# ECOM_N8N_BASE_URL=https://n8n.sedge.ai/webhook
# ECOM_AI_REWRITE_STUB=false
# AI_GATEWAY_INTROSPECT_URL=https://api.example.com/api/v1/auth/me   # require a valid bearer (once the real backend exists)
# AI_GATEWAY_RATE_LIMIT=30                                           # requests / minute / IP
# VITE_AI_USE_MSW_STUB=true                                           # browser: stub the AI routes in MSW
