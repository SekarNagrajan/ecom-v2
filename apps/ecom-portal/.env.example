# API
VITE_API_URL=http://localhost:8080/api/v1
VITE_API_MODE=mock
VITE_APP_TITLE=Solverminds E-Commerce Portal

# AI Assistant (portal kill switch — string "true" / "false", not boolean)
VITE_ASSISTANT_ENABLED=true

# When true, MSW serves a scripted SSE stub for /api/assistant/*.
# When false (default), MSW passthrough → Vite proxy → AI service.
VITE_AI_ASSISTANT_USE_MSW_STUB=false

# Node-only (not VITE_*): Vite / preview proxy target for /api/assistant/*
# AI_ASSISTANT_BASE_URL=http://localhost:8000
# ECOM_AI_SERVICE_URL=http://localhost:8000
