# Optional AIS WebSocket proxy (see src/features/tracking/tools/ais-proxy.mjs).
# Leave unset to use mock AIS animation only.
# VITE_AIS_PROXY_URL=ws://localhost:8080

# AG Grid Enterprise license. Set in Vercel for Production and Preview.
# Vite inlines this at build time, so a change requires a new deployment.
# VITE_AG_GRID_LICENSE_KEY=

# API mode: mock (MSW in the browser, default) or real (VITE_API_URL). Demo builds use mock.
# VITE_API_MODE=mock
# VITE_API_URL=http://localhost:8080/api/v1
