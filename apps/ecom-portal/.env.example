# Copy to .env.local for local overrides (not committed).

# Portal API mode: mock (MSW) | real
# VITE_API_MODE=mock

# Real backend base for non-AI feature APIs (not used by /api/ai/*)
# VITE_API_URL=http://localhost:8080/api/v1

# AI text assist — Vite Node proxy (vite-ai-n8n-proxy.ts). Same-origin /api/ai/*
# maps to n8n webhooks (CRM API is not involved):
#   /api/ai/grammar    → {N8N_BASE_URL}/grammar              (Groq Grammar Check)
#   /api/ai/transcribe → {N8N_BASE_URL}/transcribe           (Groq Audio Transcription)
#   /api/ai/rewrite    → {N8N_BASE_URL}/v2/mail/rewrite      (Mail_Tone_Rewrite)
# In mock mode MSW passthroughs /api/ai/* to Vite→n8n by default.
# VITE_AI_USE_MSW_STUB=true
# N8N_BASE_URL=https://n8n.sedge.ai/webhook
# ECOM_N8N_BASE_URL=https://n8n.sedge.ai/webhook
# ECOM_AI_REWRITE_STUB=false
