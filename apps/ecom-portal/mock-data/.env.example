# Read-only SQL Server logins. The extractors only run SELECT statements.
# Leave a line out to skip every dataset that depends on that database.
# Logical names follow the EJB datasources; on the LRP V2 test server they map to:
#   ECOMDB=Ecomm_JSF  MASTERDB=Masters  LRPV1DS=Documentation  REPORTDB=ReportDB  VSSDB=VSS  COMDB=Commercial  ACCDB=Accounts  IMPDB=Imports
# (`node databases.js` lists the databases a login can see; `node match-lrp.js` finds the LRP database that holds the sampled bookings.)
DB_ECOMDB=Server=yourhost,1433;Database=Ecomm_JSF;User Id=ro_user;Password=xxx;Encrypt=false;TrustServerCertificate=true
DB_MASTERDB=Server=yourhost,1433;Database=Masters;User Id=ro_user;Password=xxx;Encrypt=false;TrustServerCertificate=true
DB_LRPV1DS=Server=yourhost,1433;Database=Documentation;User Id=ro_user;Password=xxx;Encrypt=false;TrustServerCertificate=true
DB_REPORTDB=Server=yourhost,1433;Database=ReportDB;User Id=ro_user;Password=xxx;Encrypt=false;TrustServerCertificate=true
DB_VSSDB=Server=yourhost,1433;Database=VSS;User Id=ro_user;Password=xxx;Encrypt=false;TrustServerCertificate=true
DB_COMDB=Server=yourhost,1433;Database=Commercial;User Id=ro_user;Password=xxx;Encrypt=false;TrustServerCertificate=true
DB_ACCDB=Server=yourhost,1433;Database=Accounts;User Id=ro_user;Password=xxx;Encrypt=false;TrustServerCertificate=true
DB_IMPDB=Server=yourhost,1433;Database=Imports;User Id=ro_user;Password=xxx;Encrypt=false;TrustServerCertificate=true

# Sample sizes
SAMPLE_CUSTOMERS=15
SAMPLE_BOOKINGS=120
SAMPLE_SI=80
SAMPLE_VGM=60
SAMPLE_PAYMENTS=40

# Shift every date column so the newest booking lands on "today" (default true)
SHIFT_DATES_TO_NOW=true

# Print SQL + row counts without writing files (also: npm run extract:dry)
# DRY_RUN=true

# Where fixtures are written (default: the portal's src/mocks/fixtures)
# OUT_DIR=../src/mocks/fixtures
