# Demo mutations from the portal (booking / SI+BL / VGM / user). Seed fixtures stay in ../src/mocks/fixtures/.
# `npm run dump` does not touch this folder. Delete runtime JSON (keep .gitkeep files) to restore dump-only seed.
runtime/**
!runtime/.gitkeep
!runtime/si/
!runtime/si/.gitkeep
!runtime/vgm/
!runtime/vgm/.gitkeep
!runtime/user/
!runtime/user/.gitkeep
